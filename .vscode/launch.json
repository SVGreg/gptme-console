{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}"
        },
        {
            "name": "Debug Session Start",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "session",
                "--start",
                "debug-session"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Session List",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "session",
                "--list"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Session Cat",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "session",
                "--cat"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Session Ask",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "session",
                "--ask",
                "How goroutines work?"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Init",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "init",
                "--path",
                "${workspaceFolder}",
                "--key",
                "sk-proj-1234567890",
                "--org",
                "org-1234567890",
                "--project",
                "project-1234567890"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}